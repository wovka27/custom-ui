{
  "name": "@wovka-dev/custom-ui",
  "version": "0.1.3",
  "description": "Strict Vue 3 interface kit.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ],
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wovka27/custom-ui.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/custom-ui.js",
  "module": "./dist/custom-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/custom-ui.js"
    },
    "./styles.css": "./dist/custom-ui.css"
  },
  "scripts": {
    "dev": "storybook dev -p 6006 --host 127.0.0.1",
    "dev:gallery": "vite",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1",
    "build-storybook": "storybook build",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build && node scripts/fix-vue-dts.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && node --test scripts/changelog-from-commits.test.mjs",
    "ci": "npm test && npm run lint && npm run build",
    "commitlint": "commitlint",
    "release": "semantic-release",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.44"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/vue3-vite": "^10.6.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^21.0.3",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "sass": "^1.105.2",
    "semantic-release": "^25.0.9",
    "storybook": "^10.6.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
